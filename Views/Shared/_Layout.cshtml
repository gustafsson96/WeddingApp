<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ever After</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WeddingApp.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        @if (!IsSectionDefined("HideNavbar"))
        {
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">EverAfter</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-flex justify-content-end">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
        }
    </header>
    @RenderSection("HideNavbar", required: false)
        <main role="main" class="container pb-5">
            @RenderBody()
        </main>

<footer class="bg-light text-dark mt-5 pt-5">
    <div class="container">
        <div class="row">

            <!-- Short about text -->
            <div class="col-md-4 mb-4">
                <h5>Ever After</h5>
                <p>We're here to help when you want to plan your perfect wedding. Follow us for tips and inspiration!</p>
            </div>

            <!-- Quick links -->
            <div class="col-md-2 mb-4">
                <h6>Quick Links</h6>
                <ul class="list-unstyled">
                    <li><a asp-controller="Home" asp-action="Index" class="text-dark">Home</a></li>
                    <li><a asp-controller="Dashboard" asp-action="Index" class="text-dark">Dashboard</a></li>
                    <li><a asp-area="Identity" asp-page="/Account/Manage/Index" class="text-dark">Profile</a></li>
                    <li><a href="#" class="text-dark">Privacy</a></li>
                </ul>
            </div>

            <!-- Support -->
            <div class="col-md-3 mb-4">
                <h6>Support</h6>
                <ul class="list-unstyled">
                    <li><a href="#" class="text-dark">Contact Us</a></li>
                    <li><a href="#" class="text-dark">FAQ</a></li>
                    <li><a href="#" class="text-dark">Terms & Conditions</a></li>
                </ul>
            </div>

            <!-- Social media -->
            <div class="col-md-3 mb-4">
                <h6>Follow Us</h6>
                <a href="https://www.facebook.com" target="_blank" class="text-dark me-2"><i class="fab fa-facebook-f"></i></a>
                <a href="https://www.instagram.com" target="_blank" class="text-dark me-2"><i class="fab fa-instagram"></i></a>
                <a href="https://www.pinterest.com" target="_blank" class="text-dark me-2"><i class="fab fa-pinterest-p"></i></a>
                <a href="https://www.tiktok.com/explore" target="_blank" class="text-dark"><i class="fab fa-tiktok"></i></a>
            </div>

        </div>

        <hr>
        <div class="text-center pb-3">
            &copy; 2026 Ever After • Made with ❤️ for unforgettable weddings
        </div>
    </div>
</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
