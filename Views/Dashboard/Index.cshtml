@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Dashboard";
}

@model WeddingApp.Models.Wedding

<h1>Admin Dashboard</h1>

@if (Model == null)
{
    <div class="dashboard-card">
        <h3>No wedding created yet</h3>
        <a asp-controller="Weddings" asp-action="Create" class="btn btn-primary">
            Create Wedding
        </a>
    </div>
}
else
{
    <div class="dashboard-grid">

        <div class="dashboard-card">
            <h3>Your Wedding</h3>
            <p>@Model.FirstPerson & @Model.SecondPerson</p>
            <p>@Model.Date.ToShortDateString()</p>

            <a asp-controller="Weddings" asp-action="Edit" asp-route-id="@Model.WeddingId" class="btn btn-secondary">
                Edit Wedding
            </a>
            <br />
            <a href="/wedding/@Model.PublicSlug" target="_blank" class="btn btn-primary">
                View Public Page
            </a>
        </div>

        <div class="dashboard-card">
            <i class="fas fa-users fa-3x"></i>
            <h3>Guests</h3>
            <a asp-controller="Guests" asp-action="Index" class="btn btn-secondary">
                Show Guests
            </a>
            <br />
            <a asp-controller="Guests" asp-action="Create" class="btn btn-primary">
                Add Guest
            </a>
        </div>

        <div class="dashboard-card">
            <i class="fas fa-gift fa-3x"></i>
            <h3>Wishlist</h3>
            <a asp-controller="Gifts" asp-action="Index" class="btn btn-secondary">
                Show Gifts
            </a>
            <br />
            <a asp-controller="Gifts" asp-action="Create" class="btn btn-primary">
                Add Gift
            </a>
        </div>

    </div>
}