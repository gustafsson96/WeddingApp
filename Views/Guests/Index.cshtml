@model IEnumerable<WeddingApp.Models.Guest>

@section Styles {
    <link rel="stylesheet" href="~/css/guestlist.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Guest List";

    var currentFilter = ViewBag.CurrentFilter as string;

    // Different filter options
    var invitedGuests = Model.Where(g => g.RSVPTime == null && g.InvitationSentAt != null).ToList();
    var respondedGuests = Model.Where(g => g.RSVPTime != null).ToList();
    var guestsNotSent = Model.Where(g => g.InvitationSentAt == null).ToList();
}

@if (!Model.Any())
{
    <div class="empty-state">
        <h2>No guests added yet</h2>
        <p>Start by adding your first guest to send invitations.</p>
        <a asp-action="Create" class="btn btn-primary">
            Add First Guest
        </a>
    </div>

    return;
}

<h1 class="page-title">Guest List</h1>

<!-- Add new guest/Back to dashboard buttons -->
<div>
    <a asp-action="Create" class="btn btn-primary">Add New Guest</a>
</div>

<!-- Tabs for filtering -->
<div class="filter-tabs">
    <a asp-action="Index" asp-route-filter="all"
       class="filter-tab @(currentFilter == "all" ? "active" : "")">
        All Guests
    </a>

    <a asp-action="Index" asp-route-filter="invited"
       class="filter-tab @(currentFilter == "invited" ? "active" : "")">
        Invited
    </a>

    <a asp-action="Index" asp-route-filter="responded"
       class="filter-tab @(currentFilter == "responded" ? "active" : "")">
        Responded
    </a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success custom-alert">
        @TempData["Message"]
    </div>
}

<!-- Filter option to show all created guests -->
@if (currentFilter == "all")
{
    <div class="guest-section">
        <h2 class="section-title">All Guests</h2>

        @if (Model.Any())
        {
            <table class="guest-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guest in Model)
                    {
                        <tr>
                            <td>@guest.Name</td>
                            <td>@guest.Email</td>
                            <td>
                                @if (guest.RSVPTime == null)
                                {
                                    if (guest.InvitationSentAt == null)
                                    {
                                        <span class="status not-sent">No invitation sent</span>
                                    }
                                    else
                                    {
                                        <span class="status pending">Invited</span>
                                    }
                                }
                                else
                                {
                                    <span class="status responded">Responded</span>
                                }
                            </td>
                            <td class="action-links">
                                <a asp-action="Edit" asp-route-id="@guest.GuestId">Edit</a> |
                                <a asp-action="Delete" asp-route-id="@guest.GuestId">Delete</a> |
                                @if (guest.InvitationSentAt == null)
                                {
                                    <form asp-action="SendInvitation" method="post" class="inline-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@guest.GuestId" />
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            Send RSVP form
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Show button if two or more guests have been created -->
            @if (guestsNotSent.Count >= 2)
            {
                <form asp-action="SendInvitations" method="post" class="bulk-invite-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn bulk-invite-btn">
                        Send RSVP form to all
                    </button>
                </form>
                <p class="bulk-info">The RSVP form will be sent to guests with status "No invitation sent".</p>
            }
        }
        else
        {
            <p class="empty-message">No guests added yet.</p>
        }
    </div>
}

@* Filtered view for guests that have been sent a RSVP form *@
@if (currentFilter == "invited")
{
    <div class="guest-section">
        <h2 class="section-title">Invited Guests</h2>

        @if (invitedGuests.Any())
        {
            <table class="guest-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guest in invitedGuests)
                    {
                        <tr>
                            <td>@guest.Name</td>
                            <td>@guest.Email</td>
                            <td>
                                <span class="status pending">Invited</span>
                            </td>
                            <td class="action-links">
                                <a asp-action="Edit" asp-route-id="@guest.GuestId">Edit</a> |
                                <a asp-action="Delete" asp-route-id="@guest.GuestId">Delete</a>
                                    <form asp-action="SendInvitation" method="post" class="inline-form" style="display:inline-block; margin-left: 0.5rem;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@guest.GuestId" />
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            Send RSVP form again
                                        </button>
                                    </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty-message">No invitations are pending at the moment.</p>
        }
    </div>
}

@* Filtered view for guests that have RSVPd *@
@if (currentFilter == "responded")
{
    <div class="guest-section">
        <h2 class="section-title">RSVP Responses</h2>

        @if (respondedGuests.Any())
        {
            <table class="guest-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Attending</th>
                        <th>Food</th>
                        <th>Allergies</th>
                        <th>Message</th>
                        <th>RSVP Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var guest in respondedGuests)
                    {
                        <tr>
                            <td>@guest.Name</td>
                            <td>@(guest.Attending == true ? "Yes" : "No")</td>
                            <td>@guest.FoodPref</td>
                            <td>@guest.Allergies</td>
                            <td>@guest.Message</td>
                            <td>@guest.RSVPTime?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                                        <td class="action-links">
                                <a asp-action="Edit" asp-route-id="@guest.GuestId">Edit</a> |
                                <a asp-action="Delete" asp-route-id="@guest.GuestId">Delete</a> 
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty-message">No RSVP responses yet.</p>
        }
    </div>
}

<div class="back-btn">
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
</div>