@section Styles {
    <link rel="stylesheet" href="~/css/guestlist.css" asp-append-version="true" />
}

@model WeddingApp.Models.Guest

@{
    ViewData["Title"] = "Create";
}

<h1>Add Guest</h1>

<h4>Fill out name and email for your guest</h4>
<hr />
<div class="form-card">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input type="hidden" asp-for="WeddingId" />
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="RSVPTime" />
            </div>
            <div class="form-group">
                <input type="hidden" asp-for="RSVPToken" />
            </div>
            <div class="form-group">
                <input asp-for="InvitationSentAt" class="form-control" type="hidden" />
            </div>
            <div class="form-group">
                <input type="submit" value="Create Guest" class="btn btn-primary" />
            </div>
        </form>
    </div>

<div class="back-container">
    <a asp-action="Index" class="btn btn-secondary">Back to Guestlist</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
