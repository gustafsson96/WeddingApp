@section Styles {
    <link rel="stylesheet" href="~/css/guestlist.css" asp-append-version="true" />
}

@model WeddingApp.Models.Guest

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Guest</h1>
<hr />
<div class="form-card">
    <div class="col-md-4">
        <form asp-action="Edit" method="post">
            @* Validation summary *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* Hidden fields *@
            <input type="hidden" asp-for="GuestId" />
            <input type="hidden" asp-for="WeddingId" />
            <input type="hidden" asp-for="RSVPToken" />
            <input type="hidden" asp-for="RSVPTime" />
            <input type="hidden" asp-for="InvitationSentAt" />

            <!-- Name field -->
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <!-- Email field -->
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" type="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

             <!-- Show the rest of the fields if a guest has RSVPd so there is information to edit -->
            @if (Model.RSVPTime != null)
            {
                @* Attending *@
                <div class="form-group">
                    <label class="control-label">Attendance</label>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Attending" value="true" />
                        <label class="form-check-label">Attending</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" asp-for="Attending" value="false" />
                        <label class="form-check-label">Not attending</label>
                    </div>
                    <span asp-validation-for="Attending" class="text-danger"></span>
                </div>
                @* Meal preference *@
                <label>Meal choice</label>
                @Html.DropDownListFor(
                    m => m.FoodPref,
                    new List<SelectListItem> {
                        new SelectListItem { Text = "Meat", Value = "Meat" },
                        new SelectListItem { Text = "Vegetarian", Value = "Vegetarian" }
                    },
                    "Select..."
                )
                @* Allergies *@
                <div class="form-group">
                    <label asp-for="Allergies" class="control-label">Allergies</label>
                    <input asp-for="Allergies" class="form-control" />
                    <span asp-validation-for="Allergies" class="text-danger"></span>
                </div>
                @* Message *@
                <div class="form-group">
                    <label asp-for="Message" class="control-label">Message</label>
                    <textarea asp-for="Message" class="form-control"></textarea>
                    <span asp-validation-for="Message" class="text-danger"></span>
                </div>
            }

            <div class="form-group form-buttons">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary cancel-btn">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
