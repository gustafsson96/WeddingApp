@model IEnumerable<WeddingApp.Models.Wedding>
@section Styles {
    <link rel="stylesheet" href="~/css/search.css" asp-append-version="true" />
}

<div class="search-page">

    <div class="search-header">
    <h2>Find a Wedding</h2>
    <p>Search for the wedding couple's names to find your event.</p>

    <!-- Search form -->
    <form asp-controller="Home" asp-action="Search" method="get" class="search-form">
        <input type="text" name="query" placeholder="Search by name..." />
        <button type="submit">Search</button>
    </form>
    </div>

    <!-- Show results if model exists -->
    @if (Model != null)
    {
        <div class="search-results">
            <h3>Search results for "@ViewBag.SearchQuery"</h3>

            @if (!Model.Any())
            {
                <p class="no-results">No weddings found.</p>
            }
            else
            {
                <div class="wedding-grid">
                    @foreach (var wedding in Model)
                    {
                        <div class="wedding-card">
                            <h4>@wedding.FirstPerson & @wedding.SecondPerson</h4>
                            <p>@wedding.Date.ToShortDateString()</p>
                            <p>@wedding.City</p>

                            <a asp-controller="Weddings"
                               asp-action="Public"
                               asp-route-slug="@wedding.PublicSlug"
                               class="view-btn"
                               target="_blank">
                                View Wedding
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    }

</div>