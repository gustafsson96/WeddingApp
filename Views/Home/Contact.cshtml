@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

@model WeddingApp.Models.ContactFormModel

@{
    ViewData["Title"] = "Contact Us";
}

<!-- Contact form -->
<section class="contact-section">
    <div class="container">
        <h2>Contact Us</h2>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">
                @ViewBag.Message
            </div>
        }

        <form asp-action="Contact" method="post">
                <p>Send us a message by filling out this form.</p>
            <div class="mb-3">
                <input asp-for="Name" class="form-control" placeholder="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <textarea asp-for="Message" class="form-control" placeholder="Message"></textarea>
                <span asp-validation-for="Message" class="text-danger"></span>
            </div>
            <div class="text-center">
                <button type="submit" class="btn primary">Send</button>
                <a class="btn cancel-btn" asp-area="" asp-controller="Home" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
