@model IEnumerable<WeddingApp.Models.Gift>

@section Styles {
    <link rel="stylesheet" href="~/css/gifts.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Gift List";
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
}

<h1 class="page-title">Gift List</h1>

<div class="gift-actions">
    <a asp-action="Create" class="btn btn-primary">Add New Gift</a>
</div>

<!-- Filter tabs -->
<div class="filter-tabs">
    <a asp-action="Index" asp-route-filter="all" class="filter-tab @(currentFilter == "all" ? "active" : "")">All Gifts</a>
    <a asp-action="Index" asp-route-filter="available" class="filter-tab @(currentFilter == "available" ? "active" : "")">Available</a>
    <a asp-action="Index" asp-route-filter="reserved" class="filter-tab @(currentFilter == "reserved" ? "active" : "")">Reserved</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <h2>No gifts found.</h2>
        <p>Try adding a new gift or switch to a different filter.</p>
        <a asp-action="Create" class="btn btn-primary">Add Gift</a>
    </div>
}
else
{
    <table class="gift-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Link</th>
                <th>Price</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var gift in Model)
            {
                <tr>
                    <td>@gift.Name</td>
                    <td>@gift.Description</td>
                    <td>
                        @if(!string.IsNullOrEmpty(gift.Link))
                        {
                            <a href="@gift.Link" target="_blank" class="gift-link btn">View Gift</a>
                        }
                    </td>
                    <td>@($"{gift.Price} SEK")</td>
                    <td>
                        @if (gift.IsReserved)
                        {
                            <span class="status reserved">Reserved</span>
                        }
                        else
                        {
                            <span class="status available">Available</span>
                        }
                    </td>
                    <td class="action-links">
                        <a asp-action="Edit" asp-route-id="@gift.GiftId">Edit</a> |
                        <a asp-action="Details" asp-route-id="@gift.GiftId">Details</a> |
                        <a asp-action="Delete" asp-route-id="@gift.GiftId">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="back-btn">
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
</div>