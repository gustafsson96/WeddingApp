@model WeddingApp.Models.Gift

@section Styles {
    <link rel="stylesheet" href="~/css/gifts.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Edit Gift";
}

<h1>Edit Gift</h1>
<hr />

<div class="form-card">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="GiftId" />
            <!-- Name -->
            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <!-- Description -->
            <div class="form-group">
                <label asp-for="Description"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <!-- Link -->
            <div class="form-group">
                <label asp-for="Link"></label>
                <input asp-for="Link" class="form-control" />
                <span asp-validation-for="Link" class="text-danger"></span>
            </div>
            <!-- Price -->
            <div class="form-group">
                <label asp-for="Price"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <!-- Image -->
            <div class="form-group">
                <label>Gift Image</label>
                <input type="file" name="giftImage" class="form-control" />
            </div>
            <!-- Buttons -->
            <div class="form-group form-buttons">
                <input type="submit" value="Save Changes" class="btn btn-primary" />
            </div>
        </form>
            <div class="back-container">
        <a asp-action="Index" class="btn btn-secondary cancel-btn">Back to Gifts</a>
    </div>
    </div>
</div>