@model WeddingApp.Models.Gift

@section Styles {
    <link rel="stylesheet" href="~/css/gifts.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Create";
}

<h1>Add Gift</h1>

<h4>The gift will be displayed in your wishlist.</h4>
<hr />

<div class="guestlist-section">
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="form-card">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Name">Gift Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Link">Link</label>
            <input asp-for="Link" class="form-control" placeholder="https://example.com" />
            <span asp-validation-for="Link" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Price">Price (SEK)</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Upload Image (optional)</label>
            <input type="file" name="giftImagePath" class="form-control" />
        </div>

        <div class="form-group">
            <input type="submit" value="Add Gift" class="btn btn-primary" />
        </div>
    </form>
    <div class="back-container">
        <a asp-action="Index" class="btn btn-secondary cancel-btn">Back to Gifts</a>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}