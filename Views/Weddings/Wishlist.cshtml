@model WeddingApp.Models.Wedding

@section Styles {
    <link rel="stylesheet" href="~/css/wishlist.css" />
}

@section HideNavbar { }

<div class="top-content">
    <h2>@Model.FirstPerson & @Model.SecondPerson's Wishlist</h2>
    <a href="/wedding/@Model.PublicSlug" class="btn btn-primary">
        Back to Wedding
    </a>
</div>

<ul id="giftList" class="gift-list">
@foreach (var gift in Model.Gifts)
{
    <li class="gift-card @(gift.IsReserved ? "reserved" : "")" data-giftid="@gift.GiftId">

        <!-- Gift Image -->
        <div class="gift-image">
            <img src="@(string.IsNullOrEmpty(gift.GiftImagePath) 
                        ? "/images/gift-placeholder.png" 
                        : gift.GiftImagePath)" 
                 alt="@gift.Name" />
        </div>

        <!-- Gift Info -->
        <div class="gift-info">
            <h3>@gift.Name</h3>

            @if (!string.IsNullOrEmpty(gift.Description))
            {
                <p>@gift.Description</p>
            }

            @if (gift.Price.HasValue)
            {
                <p><strong>Price:</strong> @gift.Price.Value.ToString("C")</p>
            }

            @if (!string.IsNullOrEmpty(gift.Link))
            {
                <p>
                    <a href="@gift.Link" target="_blank" rel="noopener" class="gift-link">
                        View product
                    </a>
                </p>
            }

            <!-- Reservation section -->
            @if (gift.IsReserved)
            {
                <span class="reserved-label">Reserved</span>
            }
            else
            {
                <button class="reserveBtn">Reserve</button>
            }
        </div>

    </li>
}
</ul>

@section Scripts {
<script>
document.querySelectorAll('.reserveBtn').forEach(btn => {
    btn.addEventListener('click', async () => {
        if (!confirm("Are you sure you want to reserve this gift?")) return;

        const li = btn.closest('li');
        const giftId = li.dataset.giftid;
        const slug = "@Model.PublicSlug";

        const res = await fetch('/Weddings/Reserve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ giftId: giftId, slug: slug })
        });

if (res.ok) {
    btn.replaceWith(
        Object.assign(document.createElement("span"), {
            textContent: "Reserved",
            className: "reserved-label"
        })
    );
        } else {
            alert('Could not reserve gift.');
        }
    });
});
</script>
}