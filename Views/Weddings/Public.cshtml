@model WeddingApp.Models.Wedding

@section Styles {
    <link rel="stylesheet" href="~/css/wedding-public.css" />
}

@section HideNavbar { }

<div class="hero-flower">
    <img src="~/images/hero-flower.png" alt="Decorative flower" />
</div>

<header class="wedding-title">
    <h1>@Model.FirstPerson & @Model.SecondPerson</h1>
    <p class="date-location">@Model.Date.ToShortDateString() • @Model.City</p>
</header>

<div class="user-header-image">
    @if (!string.IsNullOrEmpty(Model.HeaderImagePath))
    {
        <img src="@Model.HeaderImagePath" alt="Header for @Model.FirstPerson & @Model.SecondPerson" />
    }
    else
    {
        <div class="header-placeholder"></div>
    }
</div>

<section class="date-venue-row">
    <div class="date-container">
        <p>@Model.Date.ToString("MMMM d yyyy")</p>
    </div>
    <div class="separator"></div>
    <div class="city-container">
        <p>@Model.City</p>
    </div>
</section>

<section class="registry-btn text-center">
    <a asp-controller="Weddings"
       asp-action="Wishlist"
       asp-route-slug="@Model.PublicSlug"
       class="btn btn-primary">
       View Registry
    </a>
</section>

<section class="wedding-info">
    <p class="big-info">@Model.Venue</p>
    <p class="small-info">@Model.Date.ToString("MMMM d yyyy")</p>
    <p class="small-info">Starts: @Model.Time</p>
    @if (!string.IsNullOrEmpty(Model.AdditionalInfo))
    {
        <p class="small-info">@Model.AdditionalInfo</p>
    }
</section>

<div class="end-container">
    <p>@Model.FirstPerson & @Model.SecondPerson</p>
    <p>@Model.Date.ToString("MMMM d yyyy")</p>
</div>
