@model WeddingApp.Models.Wedding

@if (!string.IsNullOrEmpty(Model.HeaderImagePath))
{
    <img src="@Model.HeaderImagePath" alt="Header for @Model.FirstPerson & @Model.SecondPerson" class="img-fluid mb-3" />
}
else
{
    <div class="mb-3" style="height:150px; background-color:#f0f0f0;"></div>
}

<div>
    <h1>@Model.FirstPerson & @Model.SecondPerson</h1>
</div>

<section>
    <h2>Welcome!</h2>
    <p>@Model.Date.ToShortDateString() kl @Model.Time</p>
    <p>@Model.Venue, @Model.City</p>
</section>

@if (!string.IsNullOrEmpty(Model.AdditionalInfo))
{
    <section>
        <h2>Information</h2>
        <p>@Model.AdditionalInfo</p>
    </section>
}