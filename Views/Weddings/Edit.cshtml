@section Styles {
    <link rel="stylesheet" href="~/css/wedding-dashboard.css" asp-append-version="true" />
}

@model WeddingApp.Models.Wedding

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Update your wedding information</h4>
<hr />
<div class="form-card">
        <a href="/wedding/@Model.PublicSlug" target="_blank" class="btn btn-primary">
            View Public Page
        </a>
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data"> 
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="WeddingId" />
            <div class="form-group">
                <label asp-for="FirstPerson" class="control-label">First person getting married</label>
                <input asp-for="FirstPerson" class="form-control" />
                <span asp-validation-for="FirstPerson" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SecondPerson" class="control-label">Second person getting married</label>
                <input asp-for="SecondPerson" class="form-control" />
                <span asp-validation-for="SecondPerson" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Date" class="control-label"></label>
                <input asp-for="Date" class="form-control" type="date" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Time" class="control-label"></label>
                <input asp-for="Time" class="form-control" type="time" />
                <span asp-validation-for="Time" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Venue" class="control-label"></label>
                <input asp-for="Venue" class="form-control" />
                <span asp-validation-for="Venue" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="City" class="control-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AdditionalInfo" class="control-label">Additional information</label>
                <textarea asp-for="AdditionalInfo" class="form-control"></textarea>
                <span asp-validation-for="AdditionalInfo" class="text-danger"></span>
            </div>
           @if (!string.IsNullOrEmpty(Model.HeaderImagePath))
               {
                <div class="image-preview">
                    <p>Your header image:</p>
                    <img src="@Model.HeaderImagePath" class="img-fluid mb-2" />

                    <button type="submit"
                        name="removeHeaderImage"
                        value="true"
                        class="remove-image-btn">
                            Remove image
                    </button>
                </div>
                <div class="form-group">
                    <label class="control-label">Change Header Image</label>
                    <input type="file" name="headerImage" class="form-control" />
                </div>
                }
                else
                {
                <div class="no-image">
                    <p>No header image</p>
                </div>
                <div class="form-group">
                    <label class="control-label">Add Header Image</label>
                    <input type="file" name="headerImage" class="form-control" />
                </div>
                }
            <div class="form-group form-buttons">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
        <div>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>
</div>
<form asp-action="Delete" method="post" asp-controller="Weddings" asp-route-id="@Model.WeddingId">
    @Html.AntiForgeryToken()
    <button type="submit" class="remove-wedding-btn"
            onclick="return confirm('Are you sure you want to delete this wedding?');">
       <i class="fas fa-trash-alt trash-icon"></i> Delete Wedding
    </button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
